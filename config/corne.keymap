#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>



/ {
    chosen {
      zmk,matrix_transform = &five_column_transform;
    };

       keymap {
                compatible = "zmk,keymap";

                default_layer {
// -----------------------------------------------------------------------------------------
// |  Q  |  W  |  E  |  R  |  T  |     |  Y  |  U   |  I   |  O   | P  | 
// |  A  |  S  |  D  |  F  |  G  |     |  H  |  J   |  K   |  L   | '/" | 
// |  Z  |  X  |  C  |  V  |  B  |     |  N  |  M   | CTRL | META | .  |
//             | GUI | LWR | SPC |     | ENT | RSE  | BSPC |
                        display-name = "Base";
                        bindings = <
   Q W E R T     Y   U  I     O     P
   A S D F G     H   J  K     L     SQT
   Z X C V B     N   M  &kp LCTL  &kp RALT  DOT
        &kp LGUI &mo 1 &kp SPACE     RET &mo 2  &kp BSPC
                        >;
                };

                lower_layer {
// -----------------------------------------------------------------------------------------
// | !     |  @  |  #  |  $  |  %  |     |  ^  |  &  |  *  |  (  |  )  |
// | BT1   | BT2 | BT3 | BT4 | BT5 |     | LFT | DWN |  UP | RGT | SHIFT |
// | BTCLR | F1  | F2  | F3  | F4  |     | F5  | F6  | F7  | F8  | F9  |
//               | GUI |     | SPC |     | ENT | ESC | TAB |
                        display-name = "Lower";
                        bindings = <
   &kp EXCL     &kp AT       &kp HASH     &kp DLLR     &kp PRCNT        &kp CARET &kp AMPS  &kp KP_MULTIPLY &kp LPAR  &kp RPAR
   &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4     &kp LEFT  &kp DOWN  &kp UP          &kp RIGHT &kp LSHIFT 
   &bt BT_CLR   &kp F1       &kp F2       &kp F3       &kp F4           &kp F5    &kp F6    &kp F7          &kp F8    &kp F9 
                             &kp LGUI     &trans       &kp SPACE        RET   &kp ESC   &kp TAB
                        >;
                };

                raise_layer {
// -----------------------------------------------------------------------------------------
// | 1! |  2@ |  3# |  4$ |  5% |     |  6^ |  7& |  8* |  9(  |  0)  |
// | -_ |  =+ |  {  |  [  |  (  |     |  )  |  ]  |  }  |  /?  |  \|  |
// | `~ |     |     |  ,< |  :  |     |  ;  |  .> | CTRL| META |      |
//            | GUI | ESC | SPC |     | ENT |     | TAB |
                        display-name = "Raise";
                        bindings = <
   N1    N2    N3    N4    N5        N6    N7    N8    N9   N0
   MINUS EQUAL &kp LBRC  &kp LBKT  &kp LPAR      &kp RPAR  &kp RBKT  &kp RBRC  FSLH BSLH
   GRAVE &trans    &trans    COMMA &kp COLON     &kp SEMI  DOT   &kp LCTRL &kp RALT &trans
                       &kp LGUI  &kp ESC   &kp SPACE     RET   &trans    &kp TAB
                        >;
                };
        };
};
